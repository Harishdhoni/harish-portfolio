rules_version = '2';

// Security rules for the portfolio's Firestore data (site content + Guild Board).
//
// THIS FILE IS THE SOURCE OF TRUTH — but only once it is published. Firestore
// denies everything that isn't matched here, so any rule added below stays
// inert (admin saves fail with "Missing or insufficient permissions") until you
// deploy it:
//
//     npm run deploy:rules        # firebase deploy --only firestore:rules
//                                 # first time: npx firebase-tools login
//
// Target project comes from .firebaserc. Editing the rules in the Firebase
// console instead works too, but then the console and this file drift apart —
// prefer the command, and re-run it after every change here.
//
// - Site content (content/, projects/, education/, certifications/, techstack/,
//   toolstack/, meta/) is world-readable; only the owner may write it.
// - Anyone may read the wall and add a pin (validated below).
// - Only the owner (matching UID) may edit or delete a pin.
// - The visitor log is owner-read-only.
service cloud.firestore {
  match /databases/{database}/documents {
    // The portfolio owner — the only account allowed to edit site content.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "iuZHEmlmHpTZlleOFw9VF5C6luf2";
    }

    // ---- Dynamic site content --------------------------------------------
    // Read is public (the site loads it for every visitor); writes are
    // owner-only and normally done from the Firebase console or
    // scripts/seedContent.js. Covers the text overlays (content/{lang}), the
    // structural collections, and the meta/site settings doc.
    match /content/{lang}      { allow read: if true; allow write: if isOwner(); }
    match /projects/{docId}    { allow read: if true; allow write: if isOwner(); }
    match /education/{docId}   { allow read: if true; allow write: if isOwner(); }
    match /certifications/{docId} { allow read: if true; allow write: if isOwner(); }
    match /techstack/{docId}   { allow read: if true; allow write: if isOwner(); }
    match /toolstack/{docId}   { allow read: if true; allow write: if isOwner(); }
    match /meta/{docId}        { allow read: if true; allow write: if isOwner(); }

    match /guildPins/{pinId} {
      allow read: if true;

      allow create: if
        request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 220
        && request.resource.data.likes == 0
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null
        && request.auth.uid == "iuZHEmlmHpTZlleOFw9VF5C6luf2";

      // Owner may edit a pin from the admin panel (message/name/loved, etc.).
      allow update: if isOwner();
    }

    // Visitor log — private analytics.
    // - Anyone may add a visit (validated below); the raw IP is never stored.
    // - Only the owner may READ or DELETE the log (visitor data stays private).
    // - A visitor may attach their own name once (empty -> a name), nothing else.
    match /visits/{visitId} {
      allow read: if request.auth != null
        && request.auth.uid == "iuZHEmlmHpTZlleOFw9VF5C6luf2";

      allow create: if
        request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && resource.data.name == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      allow delete: if request.auth != null
        && request.auth.uid == "iuZHEmlmHpTZlleOFw9VF5C6luf2";
    }
  }
}
